# Copy to .env for local runs (docker-compose injects these in the container).

# Async SQLAlchemy URL. In docker-compose the host is the service name "db".
RF_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchfrontier

# Exact frontend origins allowed by CORS (comma-separated).
RF_CORS_ORIGINS=http://localhost:5173,https://researchfrontier.github.io

# --- Live ingestion (optional; the bundled seed needs none of these) ---
# Free OpenAlex key raises the daily credit budget 10x (openalex.org/settings/api).
RF_OPENALEX_API_KEY=
# Your contact email, sent as polite-pool etiquette to OpenAlex/Crossref. YOUR email only.
RF_CONTACT_EMAIL=

# Measure "last N days" windows from the latest paper in the DB (keeps the seed
# visible). Set false in production once live ingestion keeps dates current.
RF_DEMO_RELATIVE_DATES=true
